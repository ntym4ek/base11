// === Стили подтемы Project ===

// Базовые стили темы Base11 (слои, сброс, токены, CSS Grid, контролы и компоненты)
// Устаревшая Flexbox-сетка (.row / .col-*) отключена по умолчанию.
// Для обратной совместимости старых шаблонов замените на:
//   @use "../../base11/css/supplies/styles";
// или с кастомным числом колонок:
//   @use "../../base11/css/supplies/styles" with ($grid-columns: 10);
@use "../../base11/css/supplies/styles" with ($enable-flex-grid: false);

// Переопределения дизайн-токенов проекта (:root)
@use "tokens";

// Специфичные стили текущей темы
// В _base.scss глобальные правила тегов (html, body, h1..h6, a) оборачивайте
// в @layer b11.base, чтобы не перебивать компоненты Base11 (.button, .pager, .menu).
@use "base";
@use "blocks";
@use "pages";
