name: Project
type: theme
description: 'Тема проекта на основе базовой темы Base11'
package: Core
version: 1.0.0
base theme: base11
core_version_requirement: ^11

libraries:
  - project/styles

  # ----------------------------------------------------------------------------
  # Кастомные библиотеки базовой темы Base11.
  # Раскомментируйте нужные библиотеки для глобального подключения в подтеме:
  # ----------------------------------------------------------------------------
  # - base11/layout-kccc       # Базовая сетка и стили структуры страниц KCCC
  # - base11/helper            # Вспомогательные JS-утилиты и общие хелперы
  # - base11/back-to-top       # Плавающая кнопка плавной прокрутки «Наверх» при скролле
  # - base11/menu-mobile       # Адаптивное мобильное меню (шторка) с поддержкой свайпов
  # - base11/swipe-events      # Обработчик touch-свайпов (влево/вправо/вверх/вниз) для мобильных
  # - base11/click-to-copy     # Кнопка копирования текста/промокодов/артикулов в буфер обмена
  # - base11/tabs-js           # Переключаемые интерактивные вкладки (табы) на чистом Vanilla JS
  # - base11/swiper-thumbs     # Синхронизация основного слайдера Swiper с блоком миниатюр (превью)
  # - base11/lightbox          # Полноэкранный лайтбокс (GLightbox v3) с авто-синхронизацией со Swiper
  # - base11/ajax-spinner      # Индикатор загрузки (спиннер) внутри нажатой кнопки при AJAX-запросах
  # - base11/facet-extension   # Мобильная шторка/backdrop и стили для фасетных фильтров (модуль Facets)
  # - base11/facet-list-filter # Живой поиск/фильтрация по чекбоксам в длинных списках фасетов

# ------------------------------------------------------------------------------
# Расширение стандартных и модульных библиотек (подключение по требованию):
# ------------------------------------------------------------------------------
# libraries-extend:
#   core/drupal.ajax:
#     - base11/ajax-spinner           # Спиннер внутри кнопки при AJAX вместо глобального затемнения
#   swiper_formatter/swiper_formatter:
#     - base11/lightbox               # Подключение лайтбокса только на страницах со слайдерами Swiper

regions:
  header: Header
  primary_menu: Primary menu
  secondary_menu: Secondary menu
  highlighted: Highlighted
  breadcrumb: Breadcrumb
  help: Help
  sidebar_first: Left sidebar
  content: Content
  sidebar_second: Right sidebar
  downlighted: Downlighted
  footer: Footer
