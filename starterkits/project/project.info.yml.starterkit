# Основные метаданные подтемы Project на базе Base11 (v2.0)
name: Project
type: theme
description: 'Тема проекта на основе базовой темы Base11'
package: Core
version: 1.0.0
base theme: base11
core_version_requirement: ^11

# Подключение стилей содержимого в админке WYSIWYG-редактора CKEditor 5
# (раскомментируйте после компиляции css/ckeditor5.scss -> css/ckeditor5.css)
# ckeditor5-stylesheets:
#   - css/ckeditor5.css

libraries:
  - project/styles

  # ----------------------------------------------------------------------------
  # Опциональные библиотеки базовой темы Base11 (подключаются глобально при необходимости):
  # (base11/messages и base11/ajax-spinner уже включены глобально в base11)
  # ----------------------------------------------------------------------------
  # - base11/font-montserrat   # Локальный шрифт Montserrat (Variable WOFF2)
  # - base11/helper            # Вспомогательные JS-утилиты и общие хелперы
  # - base11/back-to-top       # Плавающая кнопка плавной прокрутки «Наверх»
  # - base11/menu-mobile       # Адаптивное мобильное меню (шторка) со свайпами
  # - base11/swipe-events      # Распознавание touch-свайпов для мобильных устройств
  # - base11/click-to-copy     # Копирование артикулов / промокодов в буфер обмена
  # - base11/tabs-js           # Переключаемые интерактивные вкладки на Vanilla JS
  # - base11/swiper-thumbs     # Двусторонняя синхронизация Swiper с миниатюрами
  # - base11/lightbox          # Полноэкранный лайтбокс (GLightbox v3) для изображений и видео
  # - base11/facet-extension   # Мобильная модалка и стили фасетных фильтров (Facets / BEF)
  # - base11/facet-list-filter # Живой поиск чекбоксов внутри длинных списков фасетов
  # - base11/layout-dashboard  # Каркас дашборда и отчётов (сайдбар + верхняя панель)
  # - base11/layout-kiosk      # Полноэкранный макет инфоэкранов (ТВ-панели)
  # - base11/filter-bar        # Панель фильтров и сегментированные переключатели
  # - base11/table-interactive # Древовидные таблицы, поиск, сортировка и sticky-колонка
  # - base11/echarts           # Графики Apache ECharts (библиотека в /libraries/echarts)
  # - base11/native-dialog     # Нативные модальные окна и шторки на базе HTML <dialog>

# ------------------------------------------------------------------------------
# Расширение модульных библиотек ядра / сторонних модулей по требованию:
# (base11/file-upload и base11/media-library уже подключены в base11.info.yml)
# ------------------------------------------------------------------------------
# libraries-extend:
#   swiper_formatter/swiper_formatter:
#     - base11/lightbox        # Лайтбокс загружается только на страницах со слайдерами

regions:
  header: Header
  primary_menu: Primary menu
  secondary_menu: Secondary menu
  highlighted: Highlighted
  breadcrumb: Breadcrumb
  help: Help
  sidebar_first: Left sidebar
  content: Content
  sidebar_second: Right sidebar
  downlighted: Downlighted
  footer: Footer
