{#
/**
 * @file
 * Базовый шаблон структуры страницы темы Base11.
 *
 * Теги doctype, html, head и body описаны в templates/layout/html.html.twig.
 *
 * Доступные переменные:
 * - base_path: Базовый URL-путь установки Drupal.
 * - is_front: Флаг главной страницы.
 * - logged_in: Флаг авторизованного пользователя.
 * - is_admin: Флаг прав администратора.
 * - front_page: URL главной страницы.
 *
 * Регионы:
 * - page.header: Логотип и элементы брендинга в шапке.
 * - page.primary_menu: Основная навигация сайта.
 * - page.secondary_menu: Дополнительное меню (язык, вход, корзина и т.д.).
 * - page.highlighted: Системные уведомления и выделенные блоки над контентом.
 * - page.breadcrumb: Навигационная цепочка (хлебные крошки).
 * - page.help: Динамическая справка (обычно для административных разделов).
 * - page.sidebar_first: Левая боковая колонка.
 * - page.content: Основное содержимое текущей страницы.
 * - page.sidebar_second: Правая боковая колонка.
 * - page.downlighted: Нижняя выделенная область под основным контентом.
 * - page.footer: Подвал сайта.
 *
 * @see \Drupal\Core\Theme\ThemePreprocess::preprocessPage()
 * @see html.html.twig
 */
#}
<div class="page-wrapper">

  {# Мобильная выдвижная шторка навигации (управляется библиотекой base11/menu-mobile) #}
  {% if page.primary_menu or page.secondary_menu %}
  <div class="page-offside">
    <div class="menu-mobile-wrapper">
      {{ page.primary_menu }}
      {{ page.secondary_menu }}
    </div>
  </div>
  {% endif %}

  <div class="page">
    {# Шапка сайта: брендинг, кнопка открытия мобильного меню и десктопная навигация #}
    {% if page.header or page.primary_menu or page.secondary_menu %}
    <header class="page-header">
      <div class="container">
        <div class="page-header__inner cluster cluster--between cluster--nowrap">
          {% if page.header %}
          <div class="page-header__brand">
            {{ page.header }}
          </div>
          {% endif %}
          {% if page.primary_menu or page.secondary_menu %}
          <div class="page-header__menu">
            <button type="button" class="page-offside-label hide-lp" aria-label="{{ 'Open menu'|t }}" aria-expanded="false">
              <span class="icon" aria-hidden="true"></span>
            </button>
            <div class="hide-sm show-lp">
              <div class="menu-wrapper">
                {{ page.primary_menu }}
                {{ page.secondary_menu }}
              </div>
            </div>
          </div>
          {% endif %}
        </div>
      </div>
    </header>
    {% endif %}

    {# Основная контентная область страницы #}
    <div class="page-content">
      <div class="container">

        {{ page.highlighted }}

        {{ page.breadcrumb }}

        {{ page.help }}

        {# Основная сетка контента: сайдбары и центральная колонка (блоки доступны для переопределения в подтемах) #}
        <div class="page-main">
          {% block page_main %}
          {% set main_grid_classes = ['page-main__grid'] %}
          {% if page.sidebar_first and page.sidebar_second %}
            {% set main_grid_classes = main_grid_classes|merge(['grid-sidebar', 'grid-sidebar--both', 'grid-sidebar--pd']) %}
          {% elseif page.sidebar_first %}
            {% set main_grid_classes = main_grid_classes|merge(['grid-sidebar', 'grid-sidebar--pd']) %}
          {% elseif page.sidebar_second %}
            {% set main_grid_classes = main_grid_classes|merge(['grid-sidebar', 'grid-sidebar--end', 'grid-sidebar--pd']) %}
          {% endif %}
          <div class="{{ main_grid_classes|join(' ') }}">
            {% if page.sidebar_first %}
            <aside class="page-sidebar page-sidebar--first">
              {{ page.sidebar_first }}
            </aside>
            {% endif %}

            <main class="page-main__content">
              {# Якорь доступности для ссылки «Перейти к основному содержимому» из html.html.twig #}
              <a id="main-content" tabindex="-1"></a>
              {% block page_content %}
                {{ page.content }}
              {% endblock %}
            </main>

            {% if page.sidebar_second %}
            <aside class="page-sidebar page-sidebar--second">
              {{ page.sidebar_second }}
            </aside>
            {% endif %}
          </div>
          {% endblock %}
        </div>

        {{ page.downlighted }}

      </div>
    </div>

    {# Подвал сайта #}
    {% if page.footer %}
    <footer class="page-footer">
      <div class="container">
        {{ page.footer }}
      </div>
    </footer>
    {% endif %}

    {# Плавающая кнопка прокрутки страницы наверх (управляется библиотекой base11/back-to-top) #}
    <button type="button" id="back-to-top" class="back-to-top" data-drupal-selector="back-to-top" aria-label="{{ 'Back to top'|t }}">
      {{ icon('base11', 'chevrons-up', { size: 24, class: 'back-to-top__icon' }) }}
    </button>

  </div>
</div>{# /.page-wrapper #}
