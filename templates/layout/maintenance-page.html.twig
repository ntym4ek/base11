{#
/**
 * @file
 * Базовый шаблон страницы технического обслуживания (offline / maintenance).
 *
 * Подключает библиотеку base11/maintenance-page и отображает карточку
 * на базе SDC-компонента base11:empty-state. Подтемы могут расширять шаблон
 * через {% extends '@base11/layout/maintenance-page.html.twig' %} и блоки:
 * - maintenance_brand
 * - maintenance_content
 * - maintenance_footer
 *
 * @see \Drupal\Core\Theme\ThemePreprocess::preprocessMaintenancePage()
 */
#}
{{ attach_library('base11/maintenance-page') }}

<div class="b11-maintenance">
  {% block maintenance_brand %}
    {% if logo or site_name or site_slogan %}
      <header class="b11-maintenance__brand" role="banner">
        {% if logo %}
          <a href="{{ front_page }}" class="b11-maintenance__logo" title="{{ 'Home'|t }}" rel="home">
            <img src="{{ logo }}" alt="{{ site_name|default('Home'|t) }}" />
          </a>
        {% endif %}

        {% if site_name %}
          <div class="b11-maintenance__site-name">
            <a href="{{ front_page }}" title="{{ 'Home'|t }}" rel="home">{{ site_name }}</a>
          </div>
        {% endif %}

        {% if site_slogan %}
          <div class="b11-maintenance__site-slogan">{{ site_slogan }}</div>
        {% endif %}
      </header>
    {% endif %}
  {% endblock %}

  <main class="b11-maintenance__main" role="main">
    <a id="main-content" tabindex="-1"></a>

    {% set highlighted_output = page.highlighted|render %}
    {% if highlighted_output|striptags|trim is not empty %}
      <div class="b11-maintenance__highlighted">{{ highlighted_output }}</div>
    {% endif %}

    {% block maintenance_content %}
      {% set maintenance_title = (title ?: 'Site under maintenance'|t)|render|striptags|trim %}
      {% embed 'base11:empty-state' with {
        title: maintenance_title,
        description: '',
        heading_level: 'h1',
        full_height: false,
        attributes: create_attribute(),
      } %}
        {% block icon %}
          {{ icon('base11', 'wrench', { size: 32 }) }}
        {% endblock %}
        {% block content %}
          {{ page.content }}
        {% endblock %}
      {% endembed %}
    {% endblock %}
  </main>

  {% block maintenance_footer %}
    {% if page.footer %}
      <footer class="b11-maintenance__footer" role="contentinfo">
        {{ page.footer }}
      </footer>
    {% endif %}
  {% endblock %}
</div>
