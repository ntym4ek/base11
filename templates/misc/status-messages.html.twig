{#
/**
 * @file
 * Переопределение шаблона системных сообщений Base11.
 *
 * Архитектурная связь с css/extensions/messages.css и js/extensions/messages.js:
 * - Корневая обёртка [data-drupal-messages] сохраняется ядром/JS для AJAX-сообщений.
 * - Внутри модальных окон сообщения выводятся inline, на странице — как toast.
 * - Закрытие выполнено семантической кнопкой <button class="close">.
 */
#}
<div data-drupal-messages>
{% block messages %}
{% for type, messages in message_list %}
  {%
    set classes = [
      'messages',
      'messages--' ~ type,
    ]
  %}
  <div role="contentinfo" aria-label="{{ status_headings[type] }}"{{ attributes.addClass(classes)|without('role', 'aria-label') }}>
    <div class="container">
      {% if type == 'error' %}
        <div role="alert">
      {% endif %}
        {% if status_headings[type] %}
          <h2 class="visually-hidden">{{ status_headings[type] }}</h2>
        {% endif %}
        {% if messages|length > 1 %}
          <ul class="messages__list">
            {% for message in messages %}
              <li class="messages__item">{{ message }}</li>
            {% endfor %}
          </ul>
        {% else %}
          {{ messages|first }}
        {% endif %}
      {% if type == 'error' %}
        </div>
      {% endif %}
    </div>
    <button type="button" class="close" aria-label="{{ 'Close'|t }}" title="{{ 'Close'|t }}"><span aria-hidden="true">&times;</span></button>
  </div>
  {% set attributes = attributes.removeClass(classes) %}
{% endfor %}
{% endblock messages %}
</div>
