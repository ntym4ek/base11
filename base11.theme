<?php

/**
 * @file
 * Functions to support theming.
 */

use Drupal\Core\Extension\ThemeSettingsProvider;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\image\Entity\ImageStyle;


/**
 * Implements hook_preprocess_html().
 */
function base11_preprocess_html(&$vars)
{
  // -- настройки темы
    // сторона расположения меню (умолчанию слева)
  $vars['attributes']['class'][] = 'page-offside-' . (\Drupal::service(ThemeSettingsProvider::class)->getSetting('page-offside-position') ?? 'left');
    // ширина экрана при которой мобильное меню заменяется на десктопное
  $vars['#attached']['drupalSettings']['theme'] = [
    'page_offside_hide_width' => \Drupal::service(ThemeSettingsProvider::class)->getSetting('page-offside-hide-width') ?? '1024',
  ];
}

/**
 * Implements hook_preprocess_page().
 */
function base11_preprocess_page(array &$vars): void
{
  // - Load the site name out of configuration.
  $config = \Drupal::config('system.site');
  $vars['site']['name'] = $config->get('name');

  // - Логотипы
  $path_theme = \Drupal::service('extension.path.resolver')->getPath('theme', 'base11');
  $vars['site']['logo']['standart'] = \Drupal::service('file_url_generator')->generateString($path_theme . '/images/logo/logo.png');
  $vars['site']['logo']['transparent'] = \Drupal::service('file_url_generator')->generateString($path_theme . '/images/logo/logo_t.png');

  // - Copyright в подвале
  $vars['site']['copyright'] = '© ' . date('Y') . ' KCCC GROUP';

  // - Можно отключить шапку
  $vars['is_header_on'] = true;

  // - Баннер с заголовком в начале страницы
  $banner = [];

  // Вывод баннера, если в папке page-banners есть изображение с именем, аналогичным пути.
  // Проверка наличия файла выполняется по всей цепочке пути, от самой длинной до короткой.
  // Для главной страницы проверяется наличие баннера с именем "front".
  $banner_uri = '';
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $paths = ['front'];
  } else {
    $current_path = \Drupal::service('path.current')->getPath();
    $current_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);

    $current_path = ltrim($current_path, '/');
    $current_alias = ltrim($current_alias, '/');

    $paths = [$current_path];
    if ($current_path !== $current_alias) {
      $paths[] = $current_alias;
    }
  }
  foreach($paths as $path) {
    if ($chunks = explode('/', $path)) {
      do {
        $filename = implode('--', $chunks);
        foreach(['jpg', 'png'] as $ext) {
          $uri = 'public://images/page-banners/' . $filename . '.' . $ext;
          if (file_exists($uri)) {
            $banner_uri = $uri;
            break;
          }
        }
        array_pop($chunks);
      } while (count($chunks));
    }
  }
  if ($banner_uri) {
    // можно задать текст или любой html для баннера
//    $banner['title'] = [
//      'prefix' => '',
//      'suffix' => '',
//      'text' => '',
//    ];

    // ширина экрана, до которой выводится мобильная версия баннера
    $banner['break'] = \Drupal::service(ThemeSettingsProvider::class)->getSetting('nav-mobile-hide-width') ?? '1024';
    $banner['image']['url'] = \Drupal::service('file_url_generator')->generateString($banner_uri);

    // если стиля для мобильного баннера не существует, создать его
    if (!ImageStyle::load('banner_mobile')) {
      $image_style = ImageStyle::create([
        'name' => 'banner_mobile',
        'label' => 'Мобильный размер баннера (1080х1080)',
      ]);
      $image_style->save();
      $image_style->addImageEffect([
        'id' => 'image_scale',
        'weight' => 0,
        'data' => [
          'width' => 1080,
          'height' => 1080,
          'upscale' => false,
        ],
      ]);
      $image_style->save();
    }
    // версия баннера для мобильных
    $banner['image']['mobile_url'] = ImageStyle::load('banner_mobile')->buildUrl($banner_uri);

    $vars['banner'] = $banner;
  }
}

/**
 * Implements hook_preprocess_image_widget().
 */
function base11_preprocess_image_widget(array &$vars): void
{
  $data = &$vars['data'];
  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}

/**
 * Implements hook_preprocess_status_messages().
 */
function base11_preprocess_status_messages(array &$vars): void
{
  if (empty($vars['message_list']['error'])) {
    return;
  }

  $request = \Drupal::request();
  $is_form_submit = $request->isMethod('POST') || $request->request->has('form_id');

  $has_form_errors = false;
  $filtered_errors = [];

  foreach ($vars['message_list']['error'] as $message) {
    $message_str = (string) $message;

    // Структурный признак inline_form_errors (якорная ссылка на поле формы <a href="#edit-...>)
    if (str_contains($message_str, 'href="#')) {
      $has_form_errors = true;
      continue; // Пропускаем сырую сводку со ссылками на поля
    }

    // Если это POST-запрос (сабмит формы), любые ошибки валидации полей относим к ошибкам формы
    if ($is_form_submit) {
      $has_form_errors = true;
      continue;
    }

    // Системные ошибки, не связанные с сабмитом форм, сохраняем как есть
    $filtered_errors[] = $message;
  }

  // Если были обнаружены ошибки заполнения формы, выводим ровно одно компактное обобщённое сообщение
  if ($has_form_errors) {
    $current_lang = \Drupal::languageManager()->getCurrentLanguage()->getId();
    $replacement = $current_lang === 'ru'
      ? 'Пожалуйста, проверьте правильность заполнения полей.'
      : t('Please check the highlighted fields for errors.');

    array_unshift($filtered_errors, $replacement);
    $vars['message_list']['error'] = $filtered_errors;
  }
}


/**
 * Implements hook_form_alter().
 *
 * Архитектурная связь с библиотекой base11/file-upload:
 * Универсально находит все одиночные поля загрузки файлов/изображений (managed_file)
 * на любых формах сущностей и оборачивает их в аккордеон <details open>.
 * Благодаря этому DOM-дерево одиночных и множественных полей становится полностью
 * идентичным (<details> -> <summary> -> .details-wrapper -> .form-type-managed-file),
 * что позволяет единообразно применять базовые функциональные стили и JS из расширения
 * base11/file-upload, а также визуальную подтемизацию (например, в project/css/_file.scss).
 */
function base11_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void
{
  _base11_wrap_single_managed_files($form, $form);
}

/**
 * Рекурсивно оборачивает одиночные виджеты managed_file в элемент details.
 *
 * В ядре Drupal множественные поля файлов оборачиваются в <details> по умолчанию
 * (\Drupal\file\Plugin\Field\FieldWidget\FileWidget::formMultipleElements),
 * а одиночные поля рендерятся плоским элементом без контейнера details.
 *
 * Данная функция устраняет это структурное различие, приводя разметку к единому стандарту.
 *
 * @param array $elements
 *   Элемент формы или ветвь массива рендеринга.
 * @param array $form
 *   Корневой массив формы для подключения библиотек.
 */
function _base11_wrap_single_managed_files(array &$elements, array &$form): void
{
  // Проверяем, является ли текущий элемент контейнером одиночного виджета managed_file
  if (
    isset($elements['widget'][0]['#type']) &&
    $elements['widget'][0]['#type'] === 'managed_file' &&
    (!isset($elements['widget']['#type']) || $elements['widget']['#type'] !== 'details')
  ) {
    $title = $elements['widget'][0]['#title'] ?? $elements['#title'] ?? '';
    $elements['widget']['#type'] = 'details';
    $elements['widget']['#open'] = TRUE;
    $elements['widget']['#title'] = $title;
    $elements['widget'][0]['#title'] = t('Добавить файл');
    if (!in_array('base11/file-upload', $form['#attached']['library'] ?? [], true)) { $form['#attached']['library'][] = 'base11/file-upload'; }
  }

  // Если обнаружен managed_file в любом виде (включая множественные поля), подключаем расширение
  if (
    (isset($elements['#type']) && $elements['#type'] === 'managed_file') ||
    (isset($elements['widget']['#type']) && $elements['widget']['#type'] === 'details' && isset($elements['widget'][0]['#type']) && $elements['widget'][0]['#type'] === 'managed_file')
  ) {
    if (!in_array('base11/file-upload', $form['#attached']['library'] ?? [], true)) { $form['#attached']['library'][] = 'base11/file-upload'; }
  }

  // Рекурсивно обходим все дочерние элементы формы
  foreach (Element::children($elements) as $key) {
    _base11_wrap_single_managed_files($elements[$key], $form);
  }
}
